{
  "name": "project-assistant",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:workbench": "node --test scripts/workbench-model.test.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "verify:restart": "node scripts/verify-restart.mjs",
    "qa:bridge": "node scripts/qa-bridge.mjs",
    "verify:ai": "node scripts/verify-ai.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "verify:planning": "node scripts/verify-planning.mjs",
    "prepare:memory:public": "node scripts/prepare-memory-public-eval.mjs",
    "evaluate:memory:public": "node scripts/evaluate-memory-public.mjs",
    "evaluate:memory:public:live": "node scripts/evaluate-memory-public-live.mjs",
    "score:memory:public:live": "node scripts/score-memory-public-live.mjs",
    "verify:memory:public:scoring": "node --test scripts/score-memory-public-live.test.mjs",
    "evaluate:memory:quality": "node scripts/evaluate-memory-quality.mjs",
    "verify:memory:quality": "node --test scripts/evaluate-memory-quality.test.mjs",
    "evaluate:memory": "node scripts/evaluate-memory.mjs",
    "evaluate:project-questions": "node scripts/evaluate-project-questions.mjs",
    "evaluate:project-questions:live": "node scripts/evaluate-project-questions.mjs --live",
    "evaluate:memory:live": "node scripts/evaluate-memory-live.mjs",
    "evaluate:memory:nonvector:live": "node scripts/evaluate-memory-live.mjs --nonvector",
    "verify:daily-use:scale": "node scripts/verify-daily-use-scale.mjs",
    "verify:retention:scoring": "node --test scripts/score-chat-retention.test.mjs",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
